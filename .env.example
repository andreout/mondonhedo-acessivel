# ==============================================================================
# Mondoñedo Accesible - Variables de Contorno (.env)
# ==============================================================================

# Porto interno onde escoita o servidor web (Predefinido: 8000)
PORT=8000

# Modo de Edición e Administración de POIs e Roteiros:
#   - "true"  -> Activa ferramentas de debuxo de rutas, edición de puntos e gardado no servidor
#   - "false" -> Modo seguro de só lectura (Recomendado para produción pública)
ENABLE_EDIT_MODE=true

# Desactivar buffering de saída de Python para visualización instantánea de logs en tempo real
PYTHONUNBUFFERED=1
